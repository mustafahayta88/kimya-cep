<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Redoks Analizi" android:textSize="22sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <EditText android:id="@+id/redox_r1" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:hint="1. Element"
                android:inputType="text" android:background="?attr/colorSurface" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginEnd="4dp"/>
            <EditText android:id="@+id/redox_r2" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:hint="2. Element"
                android:inputType="text" android:background="?attr/colorSurface" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginStart="4dp"/>
            <Button android:id="@+id/redox_analiz" android:layout_width="wrap_content"
                android:layout_height="48dp" android:text="Analiz Et" android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary" android:paddingHorizontal="12dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/redox_presets" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="4dp"/>
        <View android:id="@+id/redox_canvas_placeholder"
            android:layout_width="match_parent" android:layout_height="350dp"
            android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/redox_sonuc" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="13sp"
            android:background="?attr/colorSurface" android:padding="10dp" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/redox_yuks" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorSecondary" android:textSize="12sp"
            android:padding="6dp" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/redox_ind" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#FFFF0080" android:textSize="12sp"
            android:padding="6dp" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/redox_detay" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?android:attr/textColorSecondary" android:textSize="11sp"
            android:padding="6dp" android:layout_marginTop="2dp"/>
    </LinearLayout>
</ScrollView>
