<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Kimyasal Denge" android:textSize="26sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kp, Kc ve Le Chatelier" android:textSize="16sp"
            android:textColor="?attr/colorSecondary" android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kp ↔ Kc Dönüşümü" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kp = Kc(RT)^Δn   |   Δn = mol ürün − mol başlangıç (gaz)"
                    android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"
                    android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_kc" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Kc değeri"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_delta_n" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Δn (mol ürün − mol başlangıç)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <EditText android:id="@+id/et_temp_kc" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Sıcaklık T (K)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_kp_kc" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Kp Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_kp_kc_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Denge Sabiti Yorumu" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="K &gt;&gt; 1 → Urunler baskin\nK ≈ 1 → Dengede\nK &lt;&lt; 1 → Reaktifler baskin\n\nQ &lt; K → Ileri yonde\nQ = K → Denge\nQ &gt; K → Ters yonde"
                    android:textColor="?attr/colorOnSurface" android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Le Chatelier Prensibi" android:textSize="16sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Değişiklik" android:textSize="14sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:layout_marginTop="4dp" android:layout_marginBottom="6dp">
                    <Button android:id="@+id/btn_le_conc" android:layout_width="0dp"
                        android:layout_height="38dp" android:layout_weight="1"
                        android:text="Konsantrasyon" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorPrimary"
                        android:layout_marginEnd="3dp" android:textSize="11sp"/>
                    <Button android:id="@+id/btn_le_pressure" android:layout_width="0dp"
                        android:layout_height="38dp" android:layout_weight="1"
                        android:text="Basınç" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorSecondary"
                        android:layout_marginHorizontal="3dp" android:textSize="11sp"/>
                    <Button android:id="@+id/btn_le_temp" android:layout_width="0dp"
                        android:layout_height="38dp" android:layout_weight="1"
                        android:text="Sıcaklık" android:textColor="#FFF"
                        android:backgroundTint="@color/neon_pink"
                        android:layout_marginStart="3dp" android:textSize="11sp"/>
                </LinearLayout>
                <TextView android:id="@+id/tv_le_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" android:lineSpacingExtra="4dp"
                    android:text="Bir değişiklik seçin"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
