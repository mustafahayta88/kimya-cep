<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="M = n / V"
                android:textSize="22sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="m = M x V x Ma"
                android:textSize="22sp"
                android:textColor="?attr/colorSecondary"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <com.kimya.uygulama.fragments.SolutionView
                android:id="@+id/solution_view"
                android:layout_width="match_parent"
                android:layout_height="200dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            <Button
                android:id="@+id/preset_1M_NaCl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="1M NaCl\n1L"
                android:textSize="10sp"
                android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary"/>
            <Button
                android:id="@+id/preset_01M_HCl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="0.1M HCl\n500mL"
                android:textSize="10sp"
                android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary"/>
            <Button
                android:id="@+id/preset_2M_H2SO4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="2M H2SO4\n250mL"
                android:textSize="10sp"
                android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary"/>
            <Button
                android:id="@+id/preset_05M_NaOH"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="0.5M NaOH\n1L"
                android:textSize="10sp"
                android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COZELTI HAZIRLAMA"
                android:textSize="18sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <EditText
                android:id="@+id/coz_hedef_M"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Hedef Molarite (M)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/coz_hedef_V"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Hedef Hacim (L)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/coz_mK"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Molar Kutle (g/mol)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stok Cozelti (opsiyonel)"
                android:textSize="14sp"
                android:textColor="?attr/colorSecondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/coz_yuzde"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Yuzde (%)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/coz_yogunluk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Yogunluk (g/mL)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/coz_hazirla"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="HAZIRLA"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/coz_sonuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorSecondary"
                android:textSize="14sp"
                android:background="?android:attr/colorBackground"
                android:minLines="3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOGUNLUKTAN MOLARITE"
                android:textSize="18sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>
            <EditText
                android:id="@+id/dcm_yuzde"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Yuzde (%)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/dcm_yogunluk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Yogunluk (g/mL)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/dcm_mK"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Molar Kutle (g/mol)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/dcm_hesapla"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="HESAPLA"
                android:textColor="#FFF"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorSecondary"
                android:layout_marginTop="8dp"/>
            <TextView
                android:id="@+id/dcm_sonuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorSecondary"
                android:textSize="14sp"
                android:background="?android:attr/colorBackground"
                android:minLines="2"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
