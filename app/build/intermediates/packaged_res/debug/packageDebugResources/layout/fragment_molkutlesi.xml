<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Formula Banner Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/mI_formula_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M = n \u00D7 Ma"
                android:textSize="28sp"
                android:textColor="?attr/colorSecondary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atom Kutlesi Hesaplayici"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Molecule View Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="?attr/colorSurface"
            android:layout_marginBottom="12dp"
            android:gravity="center">

            <com.kimya.uygulama.fragments.MoleculeView
                android:id="@+id/mI_molecule_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- Preset Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:weightSum="3">

            <Button
                android:id="@+id/mI_h2so4"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="H2SO4"
                android:textColor="#FFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/mI_caco3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="CaCO3"
                android:textColor="#FFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorPrimary" />

            <Button
                android:id="@+id/mI_naoh"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="NaOH"
                android:textColor="#FFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Formula Input -->
        <EditText
            android:id="@+id/mI_formul"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Formul girin (orn: H2O)"
            android:inputType="text"
            android:background="?attr/colorSurface"
            android:padding="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/mI_hesapla"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="HESAPLA"
                android:textColor="#FFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorSecondary" />

            <Button
                android:id="@+id/mI_paylas"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="PAYLAS"
                android:textColor="#FFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Result Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mI_sonuc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Compound Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mI_bilesik_bilgi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
