<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Organik Kimya" android:textSize="22sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Karbon atomlari yerlestir, baglarla birlestir, adlandir" android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"/>
        <View android:id="@+id/org_canvas_placeholder"
            android:layout_width="match_parent" android:layout_height="550dp"
            android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="El:" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
                android:layout_gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/org_elem_c" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="C" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#6B6B6B" android:enabled="false"/>
            <Button android:id="@+id/org_elem_h" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="H" android:textSize="13sp" android:textColor="#000"
                android:backgroundTint="#FFFFFF" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_elem_o" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="O" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#FF0000" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_elem_n" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="N" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#3050F8" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="3dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Gr:" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
                android:layout_gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/org_elem_cl" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Cl" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#1FC01F"/>
            <Button android:id="@+id/org_elem_br" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Br" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#A52525" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_elem_oh" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="OH" android:textSize="12sp" android:textColor="#FFF"
                android:backgroundTint="#FF69B4" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_elem_r" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="R" android:textSize="13sp" android:textColor="#FFF"
                android:backgroundTint="#FFA500" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bag:" android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
                android:layout_gravity="center_vertical" android:layout_marginEnd="4dp"/>
            <Button android:id="@+id/org_bond_single" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Tekli" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary" android:enabled="false"/>
            <Button android:id="@+id/org_bond_double" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Ikili" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="3dp"/>
            <Button android:id="@+id/org_bond_triple" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Uclu" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginEnd="3dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <Button android:id="@+id/org_ring" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Halka" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/org_benzene" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Benzen" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_example" android:layout_width="0dp" android:layout_height="32dp"
                android:layout_weight="1" android:text="Ornek>" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="5dp">
            <Button android:id="@+id/org_connect" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Bagla" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/neon_pink" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/org_del" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Sil" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/neon_red" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_undo" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Geri" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_clear" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="Temizle" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/org_toggle_h" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:text="H+" android:textSize="11sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <Button android:id="@+id/org_adlandir" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Adlandir" android:textSize="16sp" android:textColor="#FFF"
            android:backgroundTint="?attr/colorSecondary" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/org_name_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
            android:textSize="32sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/org_formula_result" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorPrimary"
            android:textSize="20sp" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/org_mol_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" android:layout_marginTop="2dp" android:layout_marginBottom="4dp"/>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bilgi:" android:textSize="18sp" android:textColor="?attr/colorPrimary"
            android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/org_info" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" android:background="?attr/colorSurface" android:padding="10dp"
            android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
