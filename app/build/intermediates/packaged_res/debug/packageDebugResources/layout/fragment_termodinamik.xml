<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Termodinamik" android:textSize="26sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ΔG = ΔH − TΔS" android:textSize="20sp"
            android:textColor="?attr/colorSecondary" android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mod Sec" android:textSize="16sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_hesapla_gibbs" android:layout_width="0dp"
                        android:layout_height="40dp" android:layout_weight="1"
                        android:text="ΔG Hesapla" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorPrimary"
                        android:layout_marginEnd="4dp" android:textSize="12sp"/>
                    <Button android:id="@+id/btn_hess" android:layout_width="0dp"
                        android:layout_height="40dp" android:layout_weight="1"
                        android:text="Hess Yasası" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorSecondary"
                        android:layout_marginStart="4dp" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gibbs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gibbs Serbest Enerji" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_enthalpy" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Entalpi ΔH (kJ/mol)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_entropy" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Entropi ΔS (J/mol·K)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <EditText android:id="@+id/et_temperature" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Sıcaklık T (K)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_calc_gibbs" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_gibbs_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hess"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hess Yasası" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ΔH_toplam = ΣΔH_ürün − ΣΔH_başlangıç"
                    android:textSize="13sp" android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_hess_elements" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Başlangıç elementleri (ör: 2,4,6)"
                    android:inputType="number"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Başlangıç elementlerinin ΔH°f değerleri (kJ/mol, virgülle):"
                    android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="6dp"/>
                <EditText android:id="@+id/et_hess_reactant_h" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="ΔH°f başlangıç (ör: -393.5,-285.8)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ürün elementlerinin ΔH°f değerleri (kJ/mol, virgülle):"
                    android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="6dp"/>
                <EditText android:id="@+id/et_hess_product_h" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="ΔH°f ürünler (ör: -241.8,-393.5)"
                    android:inputType="numberDecimal|numberSigned"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <EditText android:id="@+id/et_hess_product_n" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Ürün stokiyometrik katsayıları (ör: 1,1)"
                    android:inputType="number"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_calc_hess" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorSecondary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_hess_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorPrimary"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Örnekler" android:textSize="16sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btn_ex1" android:layout_width="match_parent"
                    android:layout_height="38dp" android:text="Süspansiyon: ΔH=-890, ΔS=-242, T=298K"
                    android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginBottom="4dp"/>
                <Button android:id="@+id/btn_ex2" android:layout_width="match_parent"
                    android:layout_height="38dp" android:text="Süblime: ΔH=+172, ΔS=+161, T=298K"
                    android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="?attr/colorSecondary" android:layout_marginBottom="4dp"/>
                <Button android:id="@+id/btn_ex3" android:layout_width="match_parent"
                    android:layout_height="38dp" android:text="Pasif olmayan: ΔH=-2220, ΔS=-386, T=298K"
                    android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="@color/neon_pink"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Bilgi" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• ΔG &lt; 0 → Spontan\n• ΔG = 0 → Denge\n• ΔG &gt; 0 → Spontan değil\n• ΔH &lt; 0 ve ΔS &gt; 0 → Her T'de spontan\n• ΔH &gt; 0 ve ΔS &lt; 0 → Hiçbir T'de spontan değil\n• T_esd = ΔH / ΔS (denge sicakligi)"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
