<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="n = m / Ma"
            android:textSize="22sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:background="?attr/colorSurface" />

        <View
            android:id="@+id/don_canvas_placeholder"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEGERLER"
                android:textSize="13sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/don_m"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="m (kutle - g)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="14dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/don_n"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="n (mol)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="14dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/don_Ma"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ma (g/mol)"
                android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground"
                android:padding="14dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAZIR ORNEKLER"
            android:textSize="13sp"
            android:textColor="?attr/colorSecondary"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/don_preset_h2o"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="18g H2O"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/colorSurface"
                android:layout_marginEnd="4dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/don_preset_nacl"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="58.44g NaCl"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/colorSurface"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/don_preset_h2so4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="98g H2SO4"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/colorSurface"
                android:layout_marginStart="4dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <Button
            android:id="@+id/don_itn_hesapla"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="HESAPLA"
            android:textColor="#0D1117"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/colorPrimary"
            android:layout_marginTop="12dp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/don_sonuc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/colorSurface"
            android:padding="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:gravity="center"
            android:minLines="3" />

    </LinearLayout>
</ScrollView>
