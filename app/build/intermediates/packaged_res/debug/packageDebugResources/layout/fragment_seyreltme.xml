<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Seyreltme Hesaplama" android:textSize="24sp"
            android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
        <View android:id="@+id/sey_canvas_placeholder"
            android:layout_width="match_parent" android:layout_height="180dp"
            android:layout_marginTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="12dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ON TANIMLI SEYRELTME" android:textSize="13sp"
                android:textColor="?attr/colorSecondary" android:textStyle="bold"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <Button android:id="@+id/sey_preset_2x"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="2x Seyreltme" android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/sey_preset_10x"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="10x Seyreltme" android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/sey_preset_1m_01m"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="1M -&gt; 0.1M" android:textColor="#FFF" android:textSize="11sp"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="12dp" android:layout_marginTop="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DEGERLER" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <EditText android:id="@+id/sey_C1"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="C1 (M)" android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/sey_V1"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="V1 (mL)" android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/sey_C2"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="C2 (M)" android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/sey_V2"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:hint="V2 (mL)" android:inputType="numberDecimal"
                android:background="?android:attr/colorBackground" android:padding="12dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="3 deger girin, bilinmeyen otomatik hesaplanir"
            android:textColor="?android:attr/textColorSecondary" android:textSize="12sp"
            android:gravity="center" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/sey_sonuc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/colorSecondary" android:textSize="14sp"
            android:background="?attr/colorSurface" android:padding="12dp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
