<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Çözeltiler" android:textSize="26sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Raoult, Donma ve Kaynama" android:textSize="16sp"
            android:textColor="?attr/colorSecondary" android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Raoult Yasası" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="P_çözücü = X_çözücü × P°_çözücü"
                    android:textSize="13sp" android:textColor="?attr/colorSecondary"
                    android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_raoult_pure" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Saf çözücünün buhar basıncı P° (mmHg)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_raoult_mol_solute" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Çözünen mol sayısı"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <EditText android:id="@+id/et_raoult_mol_solvent" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Çözücü mol sayısı"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_raoult" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_raoult_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Donma Noktası Alçalması" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ΔT_f = K_f × m × i  |  Su için K_f = 1.86 °C/m"
                    android:textSize="13sp" android:textColor="?attr/colorPrimary"
                    android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_fp_molality" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Molerlik (m = mol/kg)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_fp_i" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="van 't Hoff katsayısı i (ör: NaCl=2)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_fp" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorSecondary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_fp_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kaynama Noktası Yükselmesi" android:textSize="16sp"
                    android:textColor="@color/neon_pink" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ΔT_b = K_b × m × i  |  Su için K_b = 0.512 °C/m"
                    android:textSize="13sp" android:textColor="?attr/colorPrimary"
                    android:fontFamily="monospace" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_bp_molality" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Molerlik (m = mol/kg)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_bp_i" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="van 't Hoff katsayısı i"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_bp" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="@color/neon_pink"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_bp_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="van 't Hoff Katsayısı (i)" android:textSize="14sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="• Non-elektrolit (glikoz, üre): i = 1\n• NaCl, KCl (1:1 tuz): i ≈ 2\n• CaCl₂, MgCl₂ (1:2 tuz): i ≈ 3\n• Na₃PO₄ (1:3 tuz): i ≈ 4\n• Sucroz: i = 1"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
