<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reaksiyon Dengeleme" android:textSize="22sp" android:textColor="?attr/colorPrimary"
            android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reaktifler" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
            android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/rea_reaktif" android:layout_width="match_parent"
            android:layout_height="44dp" android:hint="Orn: H2+O2" android:inputType="text"
            android:background="?attr/colorSurface" android:padding="10dp" android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Urunler" android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
            android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/rea_urun" android:layout_width="match_parent"
            android:layout_height="44dp" android:hint="Orn: H2O" android:inputType="text"
            android:background="?attr/colorSurface" android:padding="10dp" android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary"/>
        <View android:id="@+id/rea_scheme_placeholder"
            android:layout_width="match_parent" android:layout_height="160dp" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/rea_dengele" android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:text="Dengele" android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/rea_paylas" android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:text="Paylas" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginStart="3dp"/>
        </LinearLayout>
        <TextView android:id="@+id/rea_sonuc" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorSecondary" android:textSize="13sp"
            android:layout_marginTop="6dp" android:background="?attr/colorSurface" android:padding="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/rea_su" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:text="Su" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/rea_tuz" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:text="Tuz" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/rea_amonyak" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:text="NH3" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/rea_hcl" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:text="HCl" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginHorizontal="2dp"/>
            <Button android:id="@+id/rea_kirec" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:text="Kirec" android:textColor="#FFF"
                android:backgroundTint="@color/line" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Verim Hesaplama" android:textSize="18sp" android:textColor="?attr/colorPrimary"
            android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/verim_teorik" android:layout_width="match_parent"
            android:layout_height="44dp" android:hint="Teorik Verim (g)" android:inputType="numberDecimal"
            android:background="?attr/colorSurface" android:padding="10dp" android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/verim_gercek" android:layout_width="match_parent"
            android:layout_height="44dp" android:hint="Gercek Verim (g)" android:inputType="numberDecimal"
            android:background="?attr/colorSurface" android:padding="10dp" android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/verim_yuzde" android:layout_width="match_parent"
            android:layout_height="44dp" android:hint="Yuzde Verim (%)" android:inputType="numberDecimal"
            android:background="?attr/colorSurface" android:padding="10dp" android:textColor="?attr/colorOnSurface"
            android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="6dp"/>
        <Button android:id="@+id/verim_hesapla" android:layout_width="match_parent"
            android:layout_height="42dp" android:text="Hesapla" android:textColor="#FFF"
            android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="6dp"/>
        <View android:id="@+id/rea_yield_placeholder" android:layout_width="match_parent"
            android:layout_height="80dp" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/verim_sonuc" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="?attr/colorSecondary" android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</ScrollView>
