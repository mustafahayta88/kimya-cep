<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GAZ KANUNLARI" android:textSize="26sp" android:textColor="?attr/colorPrimary"
            android:textStyle="bold" android:layout_marginBottom="4dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PV = nRT" android:textSize="20sp" android:textColor="?attr/colorSecondary"
            android:textStyle="bold" android:layout_marginBottom="12dp"/>

        <!-- Canvas -->
        <View android:id="@+id/gaz_canvas_placeholder"
            android:layout_width="match_parent" android:layout_height="48dp"/>

        <!-- Card 1: Ideal Gaz Kanunu -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="14dp" android:layout_marginTop="8dp"
            android:elevation="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ideal Gaz Kanunu" android:textSize="18sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/gaz_P" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Basinc (P) atm"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_V" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Hacim (V) L"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_n" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Mol (n)"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_T" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Sicaklik (T) K"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <Button android:id="@+id/gaz_hesapla" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="Hesapla (Bos alani bul)"
                android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/gaz_sonuc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                android:textSize="14sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Presets -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="14dp" android:layout_marginTop="8dp" android:elevation="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hazir Degerler" android:textSize="16sp"
                android:textColor="?attr/colorAccent" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/gaz_stp" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1"
                    android:text="STP (1mol, 22.4L)" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginEnd="4dp"
                    android:textSize="11sp"/>
                <Button android:id="@+id/gaz_oda" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1"
                    android:text="Oda (1mol, 24.5L)" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorSecondary" android:layout_marginStart="4dp"
                    android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/gaz_preset1" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1"
                    android:text="2mol 1atm 300K" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorAccent" android:layout_marginEnd="4dp"
                    android:textSize="11sp"/>
                <Button android:id="@+id/gaz_preset2" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1"
                    android:text="0.5mol STP" android:textColor="#FFF"
                    android:backgroundTint="@color/neon_red" android:layout_marginStart="4dp"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Gaz Mol Kutlesi -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="14dp" android:layout_marginTop="8dp" android:elevation="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Gaz Mol Kutlesi" android:textSize="18sp"
                android:textColor="?attr/colorSecondary" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/gaz_mI_kutle" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Kutle (g)"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_mI_V" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Hacim (V) L"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_mI_T" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Sicaklik (T) K"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/gaz_mI_P" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Basinc (P) atm"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <Button android:id="@+id/gaz_mI_itn" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="Mol Kutlesini Hesapla"
                android:textColor="#FFF" android:backgroundTint="?attr/colorSecondary"
                android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/gaz_mI_sonuc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="?attr/colorPrimary"
                android:textSize="14sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
