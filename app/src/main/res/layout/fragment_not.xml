<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="not" android:textSize="24sp" android:textColor="?attr/colorPrimary"
            android:textStyle="bold"/>
        <EditText android:id="@+id/not_edit"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="edit" android:inputType="text"
            android:background="?attr/colorSurface" android:padding="12dp"
            android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
            android:layout_marginTop="8dp"/>
        <Button android:id="@+id/not_kaydet"
            
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="kaydet" android:textColor="#FFF"
            android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/not_kaydet_dosya"
            
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="kaydet dosya" android:textColor="#FFF"
            android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/not_paylas"
            
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="paylas" android:textColor="#FFF"
            android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/not_temizle"
            
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="temizle" android:textColor="#FFF"
            android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>