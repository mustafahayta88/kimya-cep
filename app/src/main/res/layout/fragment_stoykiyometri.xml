<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STOKIYOMETRI" android:textSize="26sp" android:textColor="?attr/colorPrimary"
            android:textStyle="bold" android:layout_marginBottom="12dp"/>

        <!-- Canvas -->
        <View android:id="@+id/sto_canvas_placeholder"
            android:layout_width="match_parent" android:layout_height="48dp"/>

        <!-- Card 1: Inputs -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="14dp" android:layout_marginTop="8dp" android:elevation="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hesaplama" android:textSize="18sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/sto_mol1" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Madde 1 (ornek: H2, NaOH)"
                android:inputType="text" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/sto_mol2" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Madde 2 (ornek: HCl, NaCl)"
                android:inputType="text" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <EditText android:id="@+id/sto_miitar" android:layout_width="match_parent"
                android:layout_height="44dp" android:hint="Miktar"
                android:inputType="numberDecimal" android:background="?android:attr/colorBackground"
                android:padding="10dp" android:textColor="?attr/colorOnSurface"
                android:textColorHint="?android:attr/textColorSecondary" android:layout_marginTop="4dp"/>

            <Spinner android:id="@+id/sto_birim" android:layout_width="match_parent"
                android:layout_height="44dp" android:layout_marginTop="4dp"
                android:background="?android:attr/colorBackground" android:padding="4dp"/>

            <Button android:id="@+id/sto_hesapla" android:layout_width="match_parent"
                android:layout_height="44dp" android:text="Hesapla"
                android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/sto_sonuc" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                android:textSize="14sp" android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Card 2: Preset Reactions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="?attr/colorSurface"
            android:padding="14dp" android:layout_marginTop="8dp" android:elevation="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hazir Tepkimeler" android:textSize="16sp"
                android:textColor="?attr/colorAccent" android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/sto_preset1" android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="H2 + Cl2 -> 2HCl" android:textColor="#FFF"
                android:backgroundTint="?attr/colorPrimary" android:textSize="12sp"/>
            <Button android:id="@+id/sto_preset2" android:layout_width="match_parent"
                android:layout_height="40dp" android:layout_marginTop="6dp"
                android:text="2H2 + O2 -> 2H2O" android:textColor="#FFF"
                android:backgroundTint="?attr/colorSecondary" android:textSize="12sp"/>
            <Button android:id="@+id/sto_preset3" android:layout_width="match_parent"
                android:layout_height="40dp" android:layout_marginTop="6dp"
                android:text="NaOH + HCl -> NaCl + H2O" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
