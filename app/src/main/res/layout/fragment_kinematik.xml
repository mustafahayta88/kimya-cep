<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Kinematik" android:textSize="26sp"
                android:textColor="?attr/colorPrimary" android:textStyle="bold"/>
            <Button android:id="@+id/btn_help" android:layout_width="40dp" android:layout_height="40dp"
                android:text="?" android:textSize="20sp" android:textColor="#FFF"
                android:backgroundTint="?attr/colorAccent" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hız Yasaları ve Reaksiyon Hızı" android:textSize="16sp"
            android:textColor="?attr/colorSecondary" android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Mertebe Seç" android:textSize="16sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_zero" android:layout_width="0dp"
                        android:layout_height="40dp" android:layout_weight="1"
                        android:text="0. Mertebe" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorPrimary"
                        android:layout_marginEnd="3dp" android:textSize="12sp"/>
                    <Button android:id="@+id/btn_first" android:layout_width="0dp"
                        android:layout_height="40dp" android:layout_weight="1"
                        android:text="1. Mertebe" android:textColor="#FFF"
                        android:backgroundTint="?attr/colorSecondary"
                        android:layout_marginHorizontal="3dp" android:textSize="12sp"/>
                    <Button android:id="@+id/btn_second" android:layout_width="0dp"
                        android:layout_height="40dp" android:layout_weight="1"
                        android:text="2. Mertebe" android:textColor="#FFF"
                        android:backgroundTint="@color/neon_pink"
                        android:layout_marginStart="3dp" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_calc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:id="@+id/tv_kin_title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0. Mertebe Hız Yasası"
                    android:textSize="16sp" android:textColor="?attr/colorPrimary"
                    android:textStyle="bold" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tv_kin_formula" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="[A] = [A]₀ − kt"
                    android:textSize="15sp" android:textColor="?attr/colorSecondary"
                    android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/et_kin_c0" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Başlangıç derişimi [A]₀ (M)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"/>
                <EditText android:id="@+id/et_kin_k" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Hız sabiti k"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <EditText android:id="@+id/et_kin_t" android:layout_width="match_parent"
                    android:layout_height="44dp" android:hint="Zaman t (s)"
                    android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="10dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Button android:id="@+id/btn_kin_calc" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Hesapla"
                    android:textColor="#FFF" android:backgroundTint="?attr/colorPrimary"
                    android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/tv_kin_result" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="?attr/colorSecondary"
                    android:textSize="15sp" android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Yarım Ömür Formülleri" android:textSize="16sp"
                    android:textColor="?attr/colorAccent" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="0. Mertebe: t½ = [A]₀ / 2k\n1. Mertebe: t½ = 0.693 / k\n2. Mertebe: t½ = 1 / (k[A]₀)"
                    android:textColor="?attr/colorOnSurface" android:textSize="14sp"
                    android:lineSpacingExtra="4dp" android:fontFamily="monospace"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Grafik Bilgisi" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tv_kin_graph_info"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="0. Mertebe: [A] vs t → düz doğru\n1. Mertebe: ln[A] vs t → düz doğru\n2. Mertebe: 1/[A] vs t → düz doğru"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
                    android:lineSpacingExtra="4dp" android:fontFamily="monospace"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
