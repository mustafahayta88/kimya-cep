<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="pH ve Asit-Baz Analizi" android:textSize="26sp"
            android:textColor="?attr/colorPrimary" android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pH Tanimi" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/ab_tanimi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?android:attr/textColorSecondary" android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:text="pH, bir cozeltinin asitlik veya bazlik derecesini olcen bir olcektir. 0-14 arasi deger alir: 0-6 arasi asidik, 7 notr, 8-14 bazik. Dusuk pH yuksek H+ konsantrasyonu gosterir."/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pH Hesaplama" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/ab_deger"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:hint="Deger gir" android:inputType="numberDecimal"
                    android:background="?android:attr/colorBackground" android:padding="12dp"
                    android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"/>
                <Spinner android:id="@+id/ab_tur"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="8dp" android:background="?android:attr/colorBackground"/>
                <Button android:id="@+id/ab_analiz"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="ANALIZ" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hizli Secim" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:weightSum="3">
                    <Button android:id="@+id/ab_asit"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:text="Kuvvetli Asit (pH=1)"
                        android:textColor="#FFF" android:textSize="10sp"
                        android:backgroundTint="#FF4444" android:layout_marginEnd="3dp"/>
                    <Button android:id="@+id/ab_preset_zayif_asit"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:text="Zayif Asit (pH=5)"
                        android:textColor="#FFF" android:textSize="10sp"
                        android:backgroundTint="#FF8800" android:layout_marginHorizontal="3dp"/>
                    <Button android:id="@+id/ab_notr"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:text="Notr (pH=7)"
                        android:textColor="#000" android:textSize="10sp"
                        android:backgroundTint="#44FF44" android:layout_marginStart="3dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:weightSum="2" android:layout_marginTop="6dp">
                    <Button android:id="@+id/ab_preset_zayif_baz"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:text="Zayif Baz (pH=9)"
                        android:textColor="#FFF" android:textSize="10sp"
                        android:backgroundTint="#4488FF" android:layout_marginEnd="3dp"/>
                    <Button android:id="@+id/ab_baz"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:text="Kuvvetli Baz (pH=13)"
                        android:textColor="#FFF" android:textSize="10sp"
                        android:backgroundTint="#8800FF" android:layout_marginStart="3dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="pH Olcegi ve Metre" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <View android:id="@+id/ab_scale_view"
                    android:layout_width="match_parent" android:layout_height="50dp"/>
                <View android:id="@+id/ab_meter_placeholder"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asit/Baz Katalog" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <ListView android:id="@+id/ab_asit_list"
                    android:layout_width="match_parent" android:layout_height="100dp"
                    android:background="?android:attr/colorBackground" android:divider="@color/line"
                    android:dividerHeight="1dp"/>
                <Button android:id="@+id/ab_asit_detay"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:text="Asit Detay" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="6dp"/>
                <ListView android:id="@+id/ab_baz_list"
                    android:layout_width="match_parent" android:layout_height="100dp"
                    android:background="?android:attr/colorBackground" android:divider="@color/line"
                    android:dividerHeight="1dp" android:layout_marginTop="8dp"/>
                <Button android:id="@+id/ab_baz_detay"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:text="Baz Detay" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notrlesme" android:textSize="16sp"
                    android:textColor="?attr/colorPrimary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/ab_notrlesme"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="NOTRLESME REAKSIYONU" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorSecondary" android:textStyle="bold"/>
                <TextView android:id="@+id/ab_katalog_sonuc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface" android:textSize="13sp"
                    android:layout_marginTop="8dp" android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sonuc" android:textSize="16sp"
                    android:textColor="?attr/colorSecondary" android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/ab_sonuc"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface" android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
                <Button android:id="@+id/ab_paylas"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:text="PAYLAS" android:textColor="#FFF"
                    android:backgroundTint="?attr/colorPrimary" android:layout_marginTop="8dp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
