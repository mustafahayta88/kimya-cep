<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?android:attr/colorBackground" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="BILESIK" android:textSize="22sp" android:textColor="?attr/colorPrimary"
            android:textStyle="bold" android:letterSpacing="0.15"/>

        <!-- Bond visualization canvas -->
        <View android:id="@+id/bilesik_canvas"
            android:layout_width="match_parent" android:layout_height="200dp"
            android:layout_marginTop="6dp"/>

        <!-- Atom seçimi row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1. Element" android:textSize="12sp" android:textColor="?attr/colorPrimary"/>
                <Spinner android:id="@+id/bilesik_el1"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="2dp" android:background="?attr/colorSurface"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Degerlik" android:textSize="12sp" android:textColor="?attr/colorPrimary"/>
                <Spinner android:id="@+id/bilesik_d1"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="2dp" android:background="?attr/colorSurface"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp" android:weightSum="2">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="2. Element" android:textSize="12sp" android:textColor="?attr/colorPrimary"/>
                <Spinner android:id="@+id/bilesik_el2"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="2dp" android:background="?attr/colorSurface"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Degerlik" android:textSize="12sp" android:textColor="?attr/colorPrimary"/>
                <Spinner android:id="@+id/bilesik_d2"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="2dp" android:background="?attr/colorSurface"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:weightSum="3">
            <Button android:id="@+id/bilesik_itn"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="Olustur" android:textColor="#FFF" android:textSize="13sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/bilesik_rastgele"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="Rastgele" android:textColor="#FFF" android:textSize="13sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/bilesik_Iart"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="Kart" android:textColor="#FFF" android:textSize="13sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="3dp"/>
        </LinearLayout>

        <!-- Quick reactions -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hizli Reaksiyonlar" android:textSize="13sp"
            android:textColor="?attr/colorPrimary" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="2dp" android:weightSum="4">
            <Button android:id="@+id/bilesik_hizli1"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="Na+Cl" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli2"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="H+O" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli3"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="Fe+O" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli4"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="Mg+Cl" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="2dp" android:weightSum="4">
            <Button android:id="@+id/bilesik_hizli5"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="H+Cl" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli6"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="C+H" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli7"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="N+H" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp"/>
            <Button android:id="@+id/bilesik_hizli8"
                android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
                android:text="Ca+O" android:textColor="#FFF" android:textSize="11sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="2dp"/>
        </LinearLayout>

        <!-- Info buttons row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:weightSum="3">
            <Button android:id="@+id/bilesik_enerji"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Enerji" android:textColor="#FFF" android:textSize="12sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/bilesik_ozelliI_itn"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Ozellik" android:textColor="#FFF" android:textSize="12sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/bilesik_kullanim_itn"
                android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                android:text="Kullanim" android:textColor="#FFF" android:textSize="12sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="3dp"/>
        </LinearLayout>

        <!-- Kosullar section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Kosullar" android:textSize="13sp"
            android:textColor="?attr/colorPrimary" android:layout_marginTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="2dp" android:weightSum="3">
            <EditText android:id="@+id/bilesik_T"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:hint="Sicaklik (K)" android:inputType="numberDecimal"
                android:background="?attr/colorSurface" android:padding="8dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="12sp" android:layout_marginEnd="3dp"/>
            <EditText android:id="@+id/bilesik_P"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:hint="Basinc (atm)" android:inputType="numberDecimal"
                android:background="?attr/colorSurface" android:padding="8dp"
                android:textColor="?attr/colorOnSurface" android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="12sp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp"/>
            <Button android:id="@+id/bilesik_sart_itn"
                android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                android:text="Hesapla" android:textColor="#FFF" android:textSize="12sp"
                android:backgroundTint="?attr/colorPrimary" android:padding="0dp"
                android:minWidth="0dp" android:layout_marginStart="3dp"/>
        </LinearLayout>

        <!-- Result text -->
        <TextView android:id="@+id/bilesik_sonuc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface" android:textSize="13sp" android:lineSpacingExtra="3dp"
            android:layout_marginTop="6dp" android:background="?attr/colorSurface" android:padding="10dp"/>
    </LinearLayout>
</ScrollView>
